NODE_ENV=test
PORT=3001
API_PREFIX=api/v1
APP_NAME=pginfo-test
LOG_LEVEL=fatal

DATABASE_URL=postgresql://pginfo:pginfo_dev@localhost:5432/pginfo_dev?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

JWT_SECRET=test-super-secret-key-at-least-32-chars-long!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=test-refresh-secret-key-at-least-32-chars-long!
JWT_REFRESH_EXPIRATION=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
