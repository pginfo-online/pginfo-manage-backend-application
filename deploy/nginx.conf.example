# TEMPLATE ONLY. Inspect nginx -T for conflicts before enabling pginfo.space.
# These limit zones must have unique names and be included within nginx's http block.
limit_req_zone $binary_remote_addr zone=pginfo_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=pginfo_auth:10m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name pginfo.space;
    location /.well-known/acme-challenge/ {
        root /var/www/pginfo-acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name pginfo.space;

    ssl_certificate /etc/letsencrypt/live/pginfo.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pginfo.space/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    limit_req_status 429;

    # Forward only trusted proxy headers. The API port must stay on loopback.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    location = / {
        proxy_pass http://127.0.0.1:3109/health/live;
    }

    location ~* ^/api/v1/auth/(login|register|refresh)/?$ {
        limit_req zone=pginfo_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3109;
    }

    # Payment retries must not be blocked by the general browser rate limit.
    location = /api/v1/webhooks/razorpay {
        proxy_pass http://127.0.0.1:3109;
    }

    location / {
        limit_req zone=pginfo_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:3109;
    }
}
