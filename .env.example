# ==========================================
# PgInfo Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==========================================

# Application
NODE_ENV=development
# In production, select an unused port on your VPS (e.g. 3109) to avoid colliding with existing apps
PORT=3000
API_PREFIX=api/v1
APP_NAME=pginfo
LOG_LEVEL=info

# PostgreSQL (Supabase or direct PostgreSQL)
# For local Docker:
# DATABASE_URL=postgresql://pginfo:pginfo_dev@localhost:5432/pginfo_dev?schema=public
# For Supabase Production on VPS with PM2 (replace path with your actual /var/www/... path):
# DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=10&connect_timeout=10&pool_timeout=20"
DATABASE_URL=postgresql://pginfo:pginfo_dev@localhost:5432/pginfo_dev?schema=public

# Redis (BullMQ queues & caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# JWT Authentication (Generate using: openssl rand -hex 64)
JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-secret
JWT_REFRESH_EXPIRATION=7d

# Cloudinary (Object/Image Storage for KYC & property photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Payment Gateway & Route Autopay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PLATFORM_FEE_PAISE=3000

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@pginfo.business

# WhatsApp (Meta Cloud API)
WHATSAPP_API_URL=https://api.example.com
WHATSAPP_API_KEY=your_whatsapp_api_key
# Direct Meta Cloud API is selected when both credentials are configured.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v23.0
META_WHATSAPP_TEMPLATE_LANGUAGE=en
META_WHATSAPP_TEMPLATE_PARAMETER_FORMAT=POSITIONAL
# Meta callback /api/v1/webhooks/whatsapp and approved rent reminder template
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_RENT_REMINDER_TEMPLATE=

# CORS (Comma-separated exact origins without trailing slashes)
CORS_ORIGINS=https://app.pginfo.business,https://api.pginfo.business,http://localhost:3000,http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
