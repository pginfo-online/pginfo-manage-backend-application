// ──────────────────────────────────────────────────────────────
// PgInfo — Prisma Schema
// ──────────────────────────────────────────────────────────────
// This is the single source of truth for the database schema.
// All changes go through prisma migrate dev.
// ──────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════
// Identity & Authentication
// ════════════════════════════════════════════════════════════════

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  mobile         String?   @unique
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String?   @map("last_name")
  emailVerified  Boolean   @default(false) @map("email_verified")
  mobileVerified Boolean   @default(false) @map("mobile_verified")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  memberships             OrganizationMember[]
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  payoutAccounts          LandlordPayoutAccount[]
  platformAdmin           PlatformAdmin?          @relation("PlatformAdminUser")
  platformAdminsCreated   PlatformAdmin[]         @relation("PlatformAdminCreator")
  adminCasesCreated       AdminCase[]             @relation("AdminCaseCreator")
  adminCasesAssigned      AdminCase[]             @relation("AdminCaseAssignee")
  platformSettingsUpdated PlatformSetting[]       @relation("PlatformSettingUpdater")

  @@map("users")
}

enum PlatformRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  ANALYST
  AUDITOR

  @@map("platform_role")
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@map("platform_admin_status")
}

model PlatformAdmin {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  role                PlatformRole
  status              PlatformAdminStatus @default(ACTIVE)
  permissionOverrides String[]            @default([]) @map("permission_overrides")
  createdByUserId     String?             @map("created_by_user_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user      User  @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PlatformAdminCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([role, status])
  @@map("platform_admins")
}

enum AdminCaseType {
  PROPERTY_VERIFICATION
  PAYOUT_KYC
  PAYMENT_REVIEW
  SUPPORT_ESCALATION
  FRAUD_REVIEW
  DATA_CORRECTION
  OTHER

  @@map("admin_case_type")
}

enum AdminCaseStatus {
  OPEN
  IN_REVIEW
  BLOCKED
  RESOLVED
  REJECTED

  @@map("admin_case_status")
}

enum AdminCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("admin_case_priority")
}

model AdminCase {
  id               String            @id @default(uuid()) @db.Uuid
  type             AdminCaseType
  status           AdminCaseStatus   @default(OPEN)
  priority         AdminCasePriority @default(MEDIUM)
  title            String
  description      String?           @db.Text
  organizationId   String?           @map("organization_id") @db.Uuid
  targetType       String?           @map("target_type")
  targetId         String?           @map("target_id")
  assignedToUserId String?           @map("assigned_to_user_id") @db.Uuid
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  resolution       String?           @db.Text
  evidence         Json?
  idempotencyKey   String?           @unique @map("idempotency_key")
  dueAt            DateTime?         @map("due_at") @db.Timestamptz
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  assignedTo User? @relation("AdminCaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy  User  @relation("AdminCaseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status, priority, createdAt])
  @@index([organizationId])
  @@index([targetType, targetId])
  @@index([assignedToUserId])
  @@map("admin_cases")
}

model PlatformSetting {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  value           Json
  description     String?
  isPublic        Boolean  @default(false) @map("is_public")
  version         Int      @default(1)
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User @relation("PlatformSettingUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("platform_settings")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  family     String    @db.Uuid // Token family for rotation & reuse detection
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy String?   @map("replaced_by") @db.Uuid // Points to the successor token
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ════════════════════════════════════════════════════════════════
// Organizations & Membership
// ════════════════════════════════════════════════════════════════

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  members        OrganizationMember[]
  properties     Property[]
  auditLogs      AuditLog[]
  payoutAccounts LandlordPayoutAccount[]
  mandates       TenantMandate[]
  rentInvoices   RentInvoice[]

  @@map("organizations")
}

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER

  @@map("org_role")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           OrgRole  @default(VIEWER)
  isActive       Boolean  @default(true) @map("is_active")
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // One membership per user per org
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

// ════════════════════════════════════════════════════════════════
// Property Management
// ════════════════════════════════════════════════════════════════

enum PropertyType {
  PG
  HOSTEL
  CO_LIVING
  FLAT
  APARTMENT
  RK
  OTHER

  @@map("property_type")
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  UNDER_MAINTENANCE

  @@map("property_status")
}

model Property {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  type           PropertyType
  status         PropertyStatus @default(ACTIVE)

  // Address
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  state        String
  pincode      String  @db.VarChar(6)
  country      String  @default("IN") @db.VarChar(2)

  // Contact
  ownerName    String? @map("owner_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  // Configuration
  timezone   String @default("Asia/Kolkata")
  rentDueDay Int    @default(1) @map("rent_due_day") // Day of month rent is due (1-28)

  // Metadata
  description String?
  amenities   String[] @default([])
  totalFloors Int?     @map("total_floors")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms              Room[]
  residents          Resident[]
  staff              Staff[]
  expenses           Expense[]
  complaints         Complaint[]
  announcements      Announcement[]
  leads              Lead[]
  bookings           Booking[]
  subMeters          SubMeter[]
  agreementTemplates AgreementTemplate[]
  payoutAccounts     LandlordPayoutAccount[]
  mandates           TenantMandate[]
  rentInvoices       RentInvoice[]

  @@unique([organizationId, name]) // Property names unique within org
  @@index([organizationId])
  @@map("properties")
}

// ════════════════════════════════════════════════════════════════
// Room & Bed Management
// ════════════════════════════════════════════════════════════════

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  PARTIALLY_OCCUPIED
  UNDER_MAINTENANCE
  ARCHIVED

  @@map("room_status")
}

enum SharingType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR_SHARING
  FIVE_SHARING
  SIX_SHARING
  SEVEN_SHARING
  EIGHT_SHARING
  NINE_SHARING
  TEN_SHARING

  @@map("sharing_type")
}

model Room {
  id                String      @id @default(uuid()) @db.Uuid
  propertyId        String      @map("property_id") @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  roomNumber        String      @map("room_number")
  floor             String      @default("0") // Flexible: "Ground", "1", "Basement", etc.
  sharingType       SharingType @map("sharing_type")
  rentAmount        Int         @map("rent_amount") // In paise per bed/unit
  status            RoomStatus  @default(AVAILABLE)
  amenities         String[]    @default([])
  description       String?
  availableFrom     DateTime?   @map("available_from") @db.Timestamptz
  unitType          String      @default("Room") @map("unit_type")
  gender            String      @default("UNISEX") @map("gender") // "MALE", "FEMALE", "UNISEX"
  remarks           String?     @map("remarks")
  lockInPeriod      String?     @default("No Lock-in") @map("lock_in_period")
  isDisabledForRent Boolean     @default(false) @map("is_disabled_for_rent")
  isPublished       Boolean     @default(true) @map("is_published")
  images            String[]    @default([]) @map("images")
  isVerified        Boolean     @default(true) @map("is_verified")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds         Bed[]
  residents    Resident[]
  complaints   Complaint[]
  mandates     TenantMandate[]
  rentInvoices RentInvoice[]

  @@unique([propertyId, roomNumber]) // Room numbers unique within property
  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([organizationId, propertyId, status, floor, roomNumber], map: "property_rooms_org_property_status_floor_idx")
  @@map("rooms")
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  UNDER_MAINTENANCE
  ARCHIVED

  @@map("bed_status")
}

model Bed {
  id                String    @id @default(uuid()) @db.Uuid
  roomId            String    @map("room_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  bedNumber         String    @map("bed_number")
  status            BedStatus @default(AVAILABLE)
  rentAmount        Int?      @map("rent_amount") // Override room rent in paise; null = use room rent
  isDisabledForRent Boolean   @default(false) @map("is_disabled_for_rent")
  remarks           String?   @map("remarks")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  room      Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  residents Resident[]
  bookings  Booking[]
  mandates  TenantMandate[]

  @@unique([roomId, bedNumber]) // Bed numbers unique within room
  @@index([organizationId])
  @@index([organizationId, roomId, status], map: "property_beds_org_room_status_idx")
  @@map("beds")
}

// ════════════════════════════════════════════════════════════════
// Resident & Occupancy Management
// ════════════════════════════════════════════════════════════════

enum ResidentStatus {
  PENDING_MOVE_IN
  ACTIVE
  NOTICE_PERIOD
  MOVED_OUT
  ARCHIVED

  @@map("resident_status")
}

enum Profession {
  STUDENT
  WORKING_PROFESSIONAL
  SELF_EMPLOYED
  OTHER

  @@map("profession")
}

model Resident {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  propertyId     String  @map("property_id") @db.Uuid
  roomId         String? @map("room_id") @db.Uuid
  bedId          String? @map("bed_id") @db.Uuid

  // Personal info
  firstName            String     @map("first_name")
  lastName             String?    @map("last_name")
  email                String?
  mobile               String
  whatsappNumber       String?    @map("whatsapp_number")
  alternatePhone       String?    @map("alternate_phone")
  sendWhatsappReminder Boolean    @default(true) @map("send_whatsapp_reminder")
  emergencyContact     String?    @map("emergency_contact")
  permanentAddress     String?    @map("permanent_address")
  parentName           String?    @map("parent_name")
  parentPhone          String?    @map("parent_phone")
  idProofUrl           String?    @map("id_proof_url")
  agreementUrl         String?    @map("agreement_url")
  profession           Profession @default(OTHER)

  // Tenancy
  status                ResidentStatus @default(PENDING_MOVE_IN)
  stayType              String         @default("LONG_TERM") @map("stay_type")
  tenantType            String         @default("OTHER") @map("tenant_type")
  noticePeriodDays      Int?           @map("notice_period_days")
  agreementPeriodMonths Int?           @map("agreement_period_months")
  monthlyRent           Int            @map("monthly_rent") // paise
  securityDeposit       Int            @default(0) @map("security_deposit") // paise
  joiningDate           DateTime       @map("joining_date") @db.Date
  moveInDate            DateTime?      @map("move_in_date") @db.Date
  moveOutDate           DateTime?      @map("move_out_date") @db.Date
  expectedVacatingDate  DateTime?      @map("expected_vacating_date") @db.Date
  lockInEndDate         DateTime?      @map("lock_in_end_date") @db.Date
  rentDueDay            Int?           @map("rent_due_day") // Override property default

  // Metadata
  notes   String?
  version Int     @default(1) // Optimistic concurrency

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  property         Property          @relation(fields: [propertyId], references: [id])
  room             Room?             @relation(fields: [roomId], references: [id])
  bed              Bed?              @relation(fields: [bedId], references: [id])
  billingRecords   BillingRecord[]
  payments         Payment[]
  occupancyHistory OccupancyRecord[]
  mandates         TenantMandate[]
  rentInvoices     RentInvoice[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  // Enforce: one active resident per bed
  // NOTE: Partial unique index must be added via raw SQL migration
  // @@unique([bedId]) WHERE status IN ('ACTIVE', 'NOTICE_PERIOD')
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "residents_org_created_idx")
  @@index([organizationId, propertyId, createdAt(sort: Desc), id(sort: Desc)], map: "residents_org_property_created_idx")
  @@map("residents")
}

model OccupancyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  residentId     String    @map("resident_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  roomId         String    @map("room_id") @db.Uuid
  bedId          String?   @map("bed_id") @db.Uuid
  monthlyRent    Int       @map("monthly_rent") // paise — rent at time of this allocation
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  reason         String? // "initial", "room_change", "bed_swap", "move_out"
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  resident Resident @relation(fields: [residentId], references: [id])

  @@index([organizationId])
  @@index([residentId])
  @@map("occupancy_records")
}

// ════════════════════════════════════════════════════════════════
// Finance, Billing & Payments
// ════════════════════════════════════════════════════════════════

enum BillingStatus {
  ISSUED
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WAIVED

  @@map("billing_status")
}

enum BillingType {
  RENT
  SECURITY_DEPOSIT
  ELECTRICITY
  WATER
  MAINTENANCE
  LATE_FEE
  OTHER

  @@map("billing_type")
}

model BillingRecord {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  residentId     String @map("resident_id") @db.Uuid
  propertyId     String @map("property_id") @db.Uuid

  type           BillingType
  status         BillingStatus @default(ISSUED)
  description    String?
  attachmentUrls String[]      @default([]) @map("attachment_urls")

  // Amounts in paise
  amount        Int // Total billed amount
  paidAmount    Int @default(0) @map("paid_amount")
  lateFeeAmount Int @default(0) @map("late_fee_amount")
  discountAmount Int @default(0) @map("discount_amount")

  // Billing period
  billingMonth Int?      @map("billing_month") // 1-12
  billingYear  Int?      @map("billing_year")
  dueDate      DateTime  @map("due_date") @db.Date
  periodStart  DateTime? @map("period_start") @db.Date
  periodEnd    DateTime? @map("period_end") @db.Date

  // Idempotency: prevent duplicate billing for same resident+type+period
  idempotencyKey String? @unique @map("idempotency_key")

  version   Int      @default(1) // Optimistic concurrency
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  resident     Resident      @relation(fields: [residentId], references: [id])
  payments     Payment[]
  rentInvoices RentInvoice[]

  // Prevent duplicate rent billing for same resident and month
  @@unique([residentId, type, billingMonth, billingYear])
  @@index([organizationId])
  @@index([residentId])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId, residentId, status, dueDate], map: "billing_records_org_resident_status_due_idx")
  @@map("billing_records")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  DISPUTED

  @@map("payment_status")
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  RAZORPAY
  OTHER

  @@map("payment_mode")
}

model Payment {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  residentId      String  @map("resident_id") @db.Uuid
  billingRecordId String? @map("billing_record_id") @db.Uuid

  amount         Int // paise
  status         PaymentStatus @default(PENDING)
  mode           PaymentMode
  collectionDate DateTime      @map("collection_date") @db.Date
  reference      String? // UPI ref, cheque number, etc.
  notes          String?
  proofUrl       String?       @map("proof_url")

  // Razorpay-specific
  razorpayOrderId   String? @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")
  razorpaySignature String? @map("razorpay_signature")

  // Audit
  recordedBy     String? @map("recorded_by") @db.Uuid // User who recorded offline payment
  idempotencyKey String? @unique @map("idempotency_key")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  resident      Resident       @relation(fields: [residentId], references: [id])
  billingRecord BillingRecord? @relation(fields: [billingRecordId], references: [id])

  @@index([organizationId])
  @@index([residentId])
  @@index([status])
  @@map("payments")
}

// ════════════════════════════════════════════════════════════════
// Expense Management
// ════════════════════════════════════════════════════════════════

model ExpenseCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean  @default(false) @map("is_system") // System-seeded categories
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  expenses Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  propertyId     String @map("property_id") @db.Uuid
  categoryId     String @map("category_id") @db.Uuid

  amount      Int // paise
  expenseDate DateTime    @map("expense_date") @db.Date
  paymentMode PaymentMode @map("payment_mode")
  paidBy      String?     @map("paid_by")
  paidTo      String?     @map("paid_to")
  description String?
  receiptUrl  String?     @map("receipt_url")
  notes       String?

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  property Property        @relation(fields: [propertyId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([organizationId])
  @@index([propertyId])
  @@index([expenseDate])
  @@map("expenses")
}

// ════════════════════════════════════════════════════════════════
// Complaints & Maintenance
// ════════════════════════════════════════════════════════════════

enum ComplaintStatus {
  RECEIVED
  VERIFIED
  NEED_MORE_TIME
  TEAM_WORKING
  PENDING
  RESOLVED

  @@map("complaint_status")
}

enum ComplaintUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("complaint_urgency")
}

model ComplaintCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  complaints Complaint[]

  @@unique([organizationId, name])
  @@map("complaint_categories")
}

model Complaint {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  propertyId     String  @map("property_id") @db.Uuid
  categoryId     String  @map("category_id") @db.Uuid
  roomId         String? @map("room_id") @db.Uuid

  description String
  location    String? // For common area complaints
  urgency     ComplaintUrgency @default(MEDIUM)
  status      ComplaintStatus  @default(RECEIVED)

  assignedTo String?   @map("assigned_to") @db.Uuid // Staff member
  resolution String?
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  property Property           @relation(fields: [propertyId], references: [id])
  category ComplaintCategory  @relation(fields: [categoryId], references: [id])
  room     Room?              @relation(fields: [roomId], references: [id])
  comments ComplaintComment[]
  history  ComplaintHistory[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@map("complaints")
}

model ComplaintComment {
  id          String   @id @default(uuid()) @db.Uuid
  complaintId String   @map("complaint_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  content     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_comments")
}

model ComplaintHistory {
  id          String          @id @default(uuid()) @db.Uuid
  complaintId String          @map("complaint_id") @db.Uuid
  fromStatus  ComplaintStatus @map("from_status")
  toStatus    ComplaintStatus @map("to_status")
  changedBy   String          @map("changed_by") @db.Uuid
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_history")
}

// ════════════════════════════════════════════════════════════════
// Staff Management
// ════════════════════════════════════════════════════════════════

enum StaffStatus {
  ACTIVE
  INACTIVE
  TERMINATED

  @@map("staff_status")
}

model StaffDesignation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  staff Staff[]

  @@unique([organizationId, name])
  @@map("staff_designations")
}

model Staff {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  propertyId     String @map("property_id") @db.Uuid
  designationId  String @map("designation_id") @db.Uuid

  firstName String      @map("first_name")
  lastName  String?     @map("last_name")
  mobile    String
  email     String?
  status    StaffStatus @default(ACTIVE)

  salary      Int? // paise — monthly salary; null if not applicable
  joiningDate DateTime? @map("joining_date") @db.Date
  exitDate    DateTime? @map("exit_date") @db.Date
  notes       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  property    Property         @relation(fields: [propertyId], references: [id])
  designation StaffDesignation @relation(fields: [designationId], references: [id])

  @@index([organizationId])
  @@index([propertyId])
  @@map("staff")
}

// ════════════════════════════════════════════════════════════════
// Announcements & Communications
// ════════════════════════════════════════════════════════════════

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED

  @@map("announcement_status")
}

enum AnnouncementScope {
  ORGANIZATION
  PROPERTY

  @@map("announcement_scope")
}

model Announcement {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  propertyId     String?            @map("property_id") @db.Uuid
  scope          AnnouncementScope
  title          String
  body           String
  status         AnnouncementStatus @default(DRAFT)
  scheduledAt    DateTime?          @map("scheduled_at") @db.Timestamptz
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz
  createdBy      String             @map("created_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
  @@map("announcements")
}

// ════════════════════════════════════════════════════════════════
// Audit Log
// ════════════════════════════════════════════════════════════════

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String // e.g. "user.login", "resident.create", "payment.record"
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json? // Additional context — never sensitive data
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations (optional, for querying)
  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════════════
// CRM & Leads Management
// ════════════════════════════════════════════════════════════════

enum LeadStatus {
  NEW
  CONTACTED
  VISITED
  TOKEN_PAID
  CONVERTED
  LOST

  @@map("lead_status")
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  propertyId        String     @map("property_id") @db.Uuid
  name              String
  mobile            String
  email             String?
  budget            Int? // paise
  sharingPreference String?    @map("sharing_preference")
  status            LeadStatus @default(NEW)
  source            String? // "website", "referral", "walk_in", "listing"
  notes             String?
  visitScheduledAt  DateTime?  @map("visit_scheduled_at") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@map("leads")
}

// ════════════════════════════════════════════════════════════════
// Bookings & Reservations
// ════════════════════════════════════════════════════════════════

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
  EXPIRED

  @@map("booking_status")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  propertyId     String        @map("property_id") @db.Uuid
  roomId         String?       @map("room_id") @db.Uuid
  bedId          String?       @map("bed_id") @db.Uuid
  guestName      String        @map("guest_name")
  guestMobile    String        @map("guest_mobile")
  guestEmail     String?       @map("guest_email")
  tokenAmount    Int           @default(0) @map("token_amount") // paise
  expectedMoveIn DateTime      @map("expected_move_in") @db.Date
  expiryDate     DateTime?     @map("expiry_date") @db.Date
  status         BookingStatus @default(CONFIRMED)
  notes          String?
  paymentMode    PaymentMode   @default(UPI) @map("payment_mode")
  paymentRef     String?       @map("payment_ref")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bed      Bed?     @relation(fields: [bedId], references: [id])

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([organizationId, propertyId, status], map: "property_bookings_org_property_status_idx")
  @@map("bookings")
}

// ════════════════════════════════════════════════════════════════
// Electric Sub-Meters
// ════════════════════════════════════════════════════════════════

model SubMeter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  roomId         String?  @map("room_id") @db.Uuid
  meterNumber    String   @map("meter_number")
  tariffRate     Int      @default(1000) @map("tariff_rate") // paise per kWh (e.g. ₹10.00/kWh = 1000 paise)
  initialReading Decimal  @default(0) @map("initial_reading") @db.Decimal(10, 2)
  currentReading Decimal  @default(0) @map("current_reading") @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  readings MeterReading[]

  @@unique([propertyId, meterNumber])
  @@index([organizationId])
  @@map("sub_meters")
}

model MeterReading {
  id            String   @id @default(uuid()) @db.Uuid
  subMeterId    String   @map("sub_meter_id") @db.Uuid
  readingDate   DateTime @map("reading_date") @db.Date
  reading       Decimal  @db.Decimal(10, 2)
  unitsConsumed Decimal  @map("units_consumed") @db.Decimal(10, 2)
  totalAmount   Int      @map("total_amount") // paise
  recordedBy    String?  @map("recorded_by") @db.Uuid
  photoUrl      String?  @map("photo_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  subMeter SubMeter @relation(fields: [subMeterId], references: [id], onDelete: Cascade)

  @@index([subMeterId])
  @@index([readingDate])
  @@map("meter_readings")
}

// ════════════════════════════════════════════════════════════════
// Rental Agreement Templates
// ════════════════════════════════════════════════════════════════

model AgreementTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String?  @map("property_id") @db.Uuid
  name           String
  content        String   @db.Text
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("agreement_templates")
}

// ════════════════════════════════════════════════════════════════
// Autopay Rent Collection & Subscriptions (Razorpay & Route)
// ════════════════════════════════════════════════════════════════

enum PayoutAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED

  @@map("payout_account_status")
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED

  @@map("kyc_status")
}

enum MandateStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  PAUSED
  REVOKED
  COMPLETED
  EXPIRED

  @@map("mandate_status")
}

enum MandateChannel {
  UPI
  EMANDATE
  CARD

  @@map("mandate_channel")
}

enum MandateCollectionMode {
  AUTOPAY
  MANUAL_COLLECTION

  @@map("mandate_collection_mode")
}

enum RentInvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELLED

  @@map("rent_invoice_status")
}

enum RentCollectionType {
  AUTOPAY
  MANUAL_COLLECTION
  FALLBACK_LINK

  @@map("rent_collection_type")
}

model LandlordPayoutAccount {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  propertyId          String?             @map("property_id") @db.Uuid
  razorpayAccountId   String              @unique @map("razorpay_account_id") // acc_xxxx
  businessName        String              @map("business_name")
  businessType        String              @default("individual") @map("business_type")
  accountNumberMasked String              @map("account_number_masked")
  ifscCode            String              @map("ifsc_code")
  beneficiaryName     String              @map("beneficiary_name")
  email               String
  phone               String
  status              PayoutAccountStatus @default(ACTIVE)
  kycStatus           KycStatus           @default(VERIFIED) @map("kyc_status")
  metadata            Json?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  mandates     TenantMandate[]

  @@index([organizationId])
  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@map("landlord_payout_accounts")
}

model TenantMandate {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  tenantId                String                @map("tenant_id") @db.Uuid
  propertyId              String                @map("property_id") @db.Uuid
  unitId                  String?               @map("unit_id") @db.Uuid
  bedId                   String?               @map("bed_id") @db.Uuid
  landlordPayoutAccountId String?               @map("landlord_payout_account_id") @db.Uuid
  razorpayPlanId          String?               @map("razorpay_plan_id")
  razorpaySubscriptionId  String                @unique @map("razorpay_subscription_id") // sub_xxxx
  razorpayCustomerId      String?               @map("razorpay_customer_id")
  razorpayTokenId         String?               @map("razorpay_token_id")
  mandateChannel          MandateChannel        @default(UPI) @map("mandate_channel")
  bankReference           String?               @map("bank_reference")
  status                  MandateStatus         @default(CREATED)
  collectionMode          MandateCollectionMode @default(AUTOPAY) @map("collection_mode")
  rentAmount              Int                   @map("rent_amount") // In paise (e.g. ₹25,000 = 2500000 paise)
  billingDay              Int                   @default(5) @map("billing_day") // 1-28
  tenureMonths            Int                   @default(11) @map("tenure_months")
  totalCount              Int                   @default(11) @map("total_count")
  paidCount               Int                   @default(0) @map("paid_count")
  shortUrl                String?               @map("short_url")
  failureReason           String?               @map("failure_reason")
  retryCount              Int                   @default(0) @map("retry_count")
  startedAt               DateTime?             @map("started_at") @db.Timestamptz
  nextChargeDate          DateTime?             @map("next_charge_date") @db.Timestamptz
  cancelledAt             DateTime?             @map("cancelled_at") @db.Timestamptz
  metadata                Json?
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant                Resident               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                  Room?                  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  bed                   Bed?                   @relation(fields: [bedId], references: [id], onDelete: SetNull)
  landlordPayoutAccount LandlordPayoutAccount? @relation(fields: [landlordPayoutAccountId], references: [id], onDelete: SetNull)
  invoices              RentInvoice[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([razorpaySubscriptionId])
  @@map("tenant_mandates")
}

model RentInvoice {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  propertyId         String             @map("property_id") @db.Uuid
  unitId             String?            @map("unit_id") @db.Uuid
  mandateId          String?            @map("mandate_id") @db.Uuid
  billingRecordId    String?            @map("billing_record_id") @db.Uuid
  invoiceNumber      String             @unique @map("invoice_number")
  billingMonth       Int                @map("billing_month") // 1-12
  billingYear        Int                @map("billing_year")
  amount             Int // Total rent in paise
  platformFee        Int                @default(3000) @map("platform_fee") // Platform cut in paise (e.g. ₹30 = 3000 paise)
  transferAmount     Int                @map("transfer_amount") // Landlord payout in paise (amount - platformFee)
  status             RentInvoiceStatus  @default(PENDING)
  collectionType     RentCollectionType @default(AUTOPAY) @map("collection_type")
  dueDate            DateTime           @map("due_date") @db.Date
  paidAt             DateTime?          @map("paid_at") @db.Timestamptz
  razorpayPaymentId  String?            @map("razorpay_payment_id") // pay_xxxx
  razorpayTransferId String?            @map("razorpay_transfer_id") // trf_xxxx
  razorpayOrderId    String?            @map("razorpay_order_id")
  fallbackPaymentUrl String?            @map("fallback_payment_url")
  retryCount         Int                @default(0) @map("retry_count")
  failureReason      String?            @map("failure_reason")
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant        Resident       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          Room?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  mandate       TenantMandate? @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  billingRecord BillingRecord? @relation(fields: [billingRecordId], references: [id], onDelete: SetNull)

  @@unique([tenantId, billingMonth, billingYear])
  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([mandateId])
  @@index([status])
  @@index([razorpayPaymentId])
  @@map("rent_invoices")
}

model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz
  status      String   @default("SUCCESS") // SUCCESS, FAILED
  error       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([eventType])
  @@index([processedAt])
  @@map("webhook_events")
}
